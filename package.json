{
  "name": "shramsetu",
  "version": "1.0.0",
  "private": true,
  "description": "ShramSetu - Cooperative-Owned Digital Service Marketplace",
  "scripts": {
    "install:all": "npm install --prefix server && npm install --prefix client",
    "dev": "concurrently -n API,WEB -c cyan,magenta \"npm run dev --prefix server\" \"npm run dev --prefix client\"",
    "dev:api": "npm run dev --prefix server",
    "dev:web": "npm run dev --prefix client",
    "seed": "npm run seed --prefix server",
    "build": "npm run build --prefix client",
    "start": "npm start --prefix server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
