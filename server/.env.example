# ---------------------------------------------------------------------------
# ShramSetu API configuration
# Copy to `.env` and adjust. Every value below has a working default, so the
# server boots with no .env at all (using an in-memory MongoDB).
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# Leave MONGO_URI blank to boot an ephemeral in-memory MongoDB (zero setup).
# Local mongod:   mongodb://127.0.0.1:27017
# Atlas cluster:  mongodb+srv://<user>:<pass>@<cluster>.mongodb.net
MONGO_URI=
DB_NAME=shramsetu

JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

CORS_ORIGIN=http://localhost:5173

# Marketplace economics -----------------------------------------------------
PLATFORM_FEE_PCT=0.02        # infrastructure cost recovery
COOP_COMMISSION_PCT=0.08     # retained by the cooperative (default; coops override)
DIVIDEND_POOL_PCT=0.4        # share of commission returned to members as dividend

# Dispatch engine -----------------------------------------------------------
DISPATCH_RADIUS_KM=8
DISPATCH_CANDIDATES=5
DISPATCH_WINDOW_SEC=45
EMERGENCY_RADIUS_KM=15

# Surge guardrails ----------------------------------------------------------
SURGE_MIN=1.0
SURGE_MAX=1.8

# Seed the in-memory DB on boot (ignored when MONGO_URI is set)
SEED_ON_BOOT=true
