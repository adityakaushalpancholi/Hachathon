# ---------------------------------------------------------------------------
# ShramSetu API configuration
# Copy to `.env` and adjust. Every value below has a working default, so the
# server boots with no .env at all (using an in-memory MongoDB).
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# Leave MONGO_URI blank to boot an ephemeral in-memory MongoDB (zero setup).
# Local mongod:   mongodb://127.0.0.1:27017
# Atlas cluster:  mongodb+srv://<user>:<pass>@<cluster>.mongodb.net
MONGO_URI=
DB_NAME=shramsetu

JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

CORS_ORIGIN=http://localhost:5173

# Marketplace economics -----------------------------------------------------
PLATFORM_FEE_PCT=0.02        # infrastructure cost recovery
COMMISSION_PCT=0.08          # the company's margin (default; each company can override)

# Dispatch engine -----------------------------------------------------------
DISPATCH_RADIUS_KM=8
DISPATCH_CANDIDATES=5
DISPATCH_WINDOW_SEC=45
EMERGENCY_RADIUS_KM=15

# Surge guardrails ----------------------------------------------------------
SURGE_MIN=1.0
SURGE_MAX=1.8

# Who may administer this deployment ----------------------------------------
# Comma-separated mobile numbers. These accounts — and only these — hold the
# admin role, re-derived from this list on every authenticated request. An
# `admin` row written straight into the database does not grant it. Leaving this
# empty means nobody can administer the deployment, which is the safe default.
OWNER_PHONES=

# Payments (Razorpay) ------------------------------------------------------
# From the Razorpay dashboard → Settings → API Keys. Leave both empty and
# online payment is simply unavailable: the Pay button does not render and
# bookings settle in cash on completion. The key id is publishable and reaches
# the browser; the secret never leaves this server.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Settings → Webhooks. Needed only for the server-to-server callback, which is
# what settles a booking when the customer closes the tab mid-payment.
RAZORPAY_WEBHOOK_SECRET=

# Seeding -------------------------------------------------------------------
# The service catalogue. Idempotent — it only fills gaps, so it is safe against
# a live database on every boot.
SEED_ON_BOOT=true
# Fictional users, bookings and earnings. Only ever runs against an in-memory or
# empty database, and production refuses to boot with it on.
SEED_DEMO=false
# Delete demo people on boot, keeping the catalogue — for a deployment that was
# demo-seeded once and now needs to be real. Refuses to touch a database that
# does not carry the demo seed's mark. Unset it again once it has run.
# Equivalent from a terminal: npm run purge:demo -- --yes
PURGE_DEMO=false
